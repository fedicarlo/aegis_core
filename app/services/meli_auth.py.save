import time
import urllib.parse
import requests

from app.config import (
    CLIENT_ID, CLIENT_SECRET, REDIRECT_URI,
    MELI_AUTH_URL, MELI_TOKEN_URL, MELI_API_URL
)
from app.database import save_tokens, update_access_token


# ── Geração do link de autorização ───────────────────────────────────────────

def build_auth_url(account_name: str) -> str:
    """
    Gera o link OAuth para uma conta específica.
    O 'state' carrega o nome da conta para identificar no callback.
    """
    params = {
        "response_type": "code",
        "client_id":     CLIENT_ID,
        "redirect_uri":  REDIRECT_URI,
        "state":         account_name,
    }

def build_auth_url(account_name: str) -> str:
    return f"https://unaging-sawyer-lightfootedly.ngrok-free.dev/authorize/{account_name}"
# ── Troca do código por tokens ────────────────────────────────────────────────

def exchange_code_for_tokens(code: str, account_name: str) -> dict:
    """
    Recebe o código retornado pelo MELI após autorização.
    Troca por access_token + refresh_token e salva no banco.
    """
    payload = {
        "grant_type":    "authorization_code",
        "client_id":     CLIENT_ID,
        "client_secret": CLIENT_SECRET,
        "code":          code,
        "redirect_uri":  REDIRECT_URI,
    }
    res = requests.post(
        MELI_TOKEN_URL,
        data=payload,
        headers={
            "accept":       "application/json",
            "content-type": "application/x-www-form-urlencoded",
        },
        timeout=15,
    )
    res.raise_for_status()
    data = res.json()

    # Busca seller_id e nickname com o token recém gerado
    user_info = get_user_info(data["access_token"])

    save_tokens(
        name          = account_name,
        seller_id     = str(user_info["id"]),
        nickname      = user_info.get("nickname", ""),
        access_token  = data["access_token"],
        refresh_token = data["refresh_token"],
        expires_in    = data.get("expires_in", 21600),
    )
    return data


# ── Renovação automática de token ─────────────────────────────────────────────

def refresh_token(account: dict) -> str:
    """
    Renova o access_token usando o refresh_token salvo.
    Atualiza o banco e retorna o novo access_token.
    """
    payload = {
        "grant_type":    "refresh_token",
        "client_id":     CLIENT_ID,
        "client_secret": CLIENT_SECRET,
        "refresh_token": account["refresh_token"],
    }
    res = requests.post(
        MELI_TOKEN_URL,
        data=payload,
        headers={
            "accept":       "application/json",
            "content-type": "application/x-www-form-urlencoded",
        },
        timeout=15,
    )
    res.raise_for_status()
    data = res.json()

    update_access_token(
        seller_id     = account["seller_id"],
        access_token  = data["access_token"],
        refresh_token = data["refresh_token"],
        expires_in    = data.get("expires_in", 21600),
    )
    return data["access_token"]


# ── Token válido (com renovação automática) ───────────────────────────────────

def get_valid_token(account: dict) -> str:
    """
    Retorna um access_token válido.
    Renova automaticamente se faltar menos de 5 minutos para expirar.
    """
    margem = 300  # segundos
    if account["expires_at"] and int(time.time()) < (account["expires_at"] - margem):
        return account["access_token"]
    return refresh_token(account)


# ── Info do usuário ───────────────────────────────────────────────────────────

def get_user_info(access_token: str) -> dict:
    """
    Retorna dados básicos da conta autenticada.
    Usado para confirmar seller_id e nickname após autorização.
    """
    res = requests.get(
        f"{MELI_API_URL}/users/me",
        headers={"Authorization": f"Bearer {access_token}"},
        timeout=15,
    )
    res.raise_for_status()
    return res.json()
